{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lofi Clouds Radio",
  "version": "1.0.0",
  "identifier": "com.lofi-clouds.radio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lofi Clouds Radio",
        "width": 400,
        "height": 600,
        "resizable": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "skipTaskbar": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
